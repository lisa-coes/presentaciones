nse:{accept:"accepted",admin_reject:"requested further edits",approve:"approved",moderator_reject:"rejected",submit:"submitted"}},sharingIcons:{label:"Share this registration via {mediaType}"},start:{page_title:"Start Registration"},update_dropdown:{accept_updates:"Accept Updates",continue_update:"Continue update",date_modified:"Date last modified: ",dropdown_title:"Updates",initiated_by:"Initiated by: ",latest:"Latest",load_more:"Load more",needs_more_updates:"Needs More Updates",no_revisions_error:"Updates unavailable.",not_a_registration_error:"That was not a registration.",not_a_revision_error:"That was not a revision.",other_error:"Some error occured. Please contact your adminstrator or moderator for further assistance.",review_update:"Review update",revision_approved_success:"Updates successfully approved.",revision_error_message:"Unable to load updates.",revision_more_updates_success:"Further updates requested of user.",revision_review_state:"Revision Review State:",revision_state_not_set_error:"Revision state not set.",updates_list_label:"Update {revisionNumber}",updates_list_label_original:"Original"}},resource_deleted:{heading:"Resource deleted",message:"User has deleted this content."},routes:{register:{create_a_free_account:"Create a free account",email:"Email",institution:"Institution",orcid:"ORCID",sign_up:"Sign Up",sign_up_using:"Sign up using:"}},settings:{account:{changePassword:{confirmPassword:{placeholder:"Verify password",title:"Confirm new password"},currentPassword:{placeholder:"Old password"},newPassword:{placeholder:"New password"},title:"Change password",updateButton:"Update password",updateFail:"Error updating password",updateSuccess:"Successfully changed password"},connected_emails:{add_email:"Add email",add_email_modal:{body:"<strong>{emailAddress}</strong> was added to your account. You will receive a confirmation email at <strong>{emailAddress}</strong>. Please click the link in your email to confirm this action. You will be required to enter your password.",title:"Confirmation email sent"},alternate_emails:"Alternate emails",confirm_delete:{body:"Are you sure you want to remove <strong>{emailAddress}</strong> from your email list?",title:"Remove email"},delete_fail:"Unable to delete email",delete_success:"Email deleted",email_address:"Email address",load_fail:"Unable to load emails",make_primary:"Make primary",merge_explanation:"To merge an existing account with this one or to log in with multiple email addresses, add an alternate email address below. All projects and components will be displayed under the email address listed as primary.",no_alternate_emails:"There are no alternate emails",no_unconfirmed_emails:"There are no unconfirmed emails",placeholder_text:"Email address",primary_email:"Primary email",resend_confirmation:"Resend confirmation",resend_confirmation_modal:{body:"Are you sure that you want to resend email confirmation to <strong>{emailAddress}</strong>?",resend_button:"Resend",title:"Resend email confirmation?"},resend_fail:"Unable to resend confirmation email",resend_success:"Email resent",save_fail:"Unable to add email",save_success:"Email added",title:"Connected emails",unconfirmed_emails:"Unconfirmed emails",update_fail:"Unable to update email",update_success:"Email updated"},connected_identities:{confirm_remove:{body:"Are you sure you want to remove this authorization?",confirm_button_text:"Remove",title:"Remove authorization?"},description:"Connected identities allow you to log in to the OSF via a third-party service.<br>You can revoke these authorizations here.",no_identities:"You have not authorized any external services to log in to the OSF.",remove_fail:'Revocation request failed. Please contact <a href="mailto:{supportEmail}">{supportEmail}</a> if the problem persists.',remove_success:"You have revoked this connected identity.",status:{pending:"Pending",verified:"Verified"},title:"Connected identities"},deactivation:{body:'Deactivating your account will remove you from all public projects to which you are a contributor. Your account will no longer be associated with OSF projects, and your work on the OSF will be inaccessible. If this is a secondary account that you want to close, consider <a href="https://help.osf.io/">merging your accounts</a>.',confirmationBody:"Are you sure you want to request account deactivation? An OSF administrator will review your request. If accepted, you will NOT be able to reactivate your account.",confirmationButton:"Request",confirmationTitle:"Request account deactivation?",confirmationToastMessage:"An OSF administrator will contact you shortly to confirm your deactivation request.",pending:"Your account is currently pending deactivation.",requestButton:"Request deactivation",title:"Deactivate account",undoRequestButton:"Undo deactivation request",undoRequestConfirmationBody:"Are you sure you want to undo your account deactivation request? This will preserve your account status.",undoRequestConfirmationButton:"Undo deactivation request",undoRequestConfirmationTitle:"Undo deactivation request?",undoRequestToastMessage:"Your deactivation request has been undone.",warning:"Warning:",warningText:"Once your deactivation has been approved the effects are irreversible."},defaultRegion:{saveError:'Could not make this change. Try again in a few minutes. If the issue persists, please report it to <a href="mailto:{supportEmail}">{supportEmail}</a>.',successToast:"You have successfully changed your default storage location to <strong>{region}</strong>",title:"Default storage location",updateButton:"Update location",why:"This location will be applied to new projects and components. It will not affect existing projects and components."},export:{body:"Exporting your account data allows you to keep a permanent copy of the current state of your account. Keeping a copy of your account data can provide peace of mind or assist in transferring your information to another provider.",confirmationBody:"Are you sure you want to request account export?",confirmationButton:"Request",confirmationTitle:"Request account export?",confirmationToastMessage:"An OSF administrator will contact you shortly to confirm your export request.",requestButton:"Request export",saveError:'Could not make this change. Try again in a few minutes. If the issue persists, please report it to <a href="mailto:{supportEmail}">{supportEmail}</a>.',title:"Export account data"},security:{disableButton:"Disable",disableTwoFactor:"Disable",disableWarning:"Are you sure you want to disable two-factor authentication?",enableButton:"Configure",enableTwoFactor:"Configure",enableWarning:"Configuring two-factor authentication will not immediately activate this feature for your account. You will need to follow the steps that appear below to complete the activation of two-factor authentication for your account.",enterVerification:"Enter your verification code:",howTo:"To use, you must install an appropriate application on your mobile device. Google Authenticator is a popular choice and is available for both Android and iOS.",importantWarning:"Important: If you lose access to your mobile device, you will not be able to log in to your OSF account.",onceVerified:"Once verified, your device will display a six-digit code that must be entered during the login process. This code changes every few seconds, which means that unauthorized users will not be able to log in to you account, even if they know your password.",saveError:'Could not make this change. Try again in a few minutes. If the issue persists, please report it to <a href="mailto:{supportEmail}">{supportEmail}</a>.',scanImage:"Scan the image below, or enter the secret key <code>{secretKey}</code> into your authentication device.",submitVerification:"Enable",title:"Security settings",twoFactorAuth:"Two-factor authentication",verificationCode:"Verification code",verificationFailed:"Verification failed. Please enter your verification code again.",why:"By using two-factor authentication, you will protect your OSF account with both your password and your mobile phone."},title:"Account settings"},addons:{title:"Configure add-on accounts"},"developer-apps":{appCallbackUrl:"Authorization callback URL",appDescription:"App description",appDetail:"Detail for app <strong>{appName}</strong>",appHomepage:"Project homepage URL",appName:"App name",backToList:"Back to list of developer apps",clientID:"Client ID",clientIDDescription:"The unique identifier for this developer app. It is safe to share publicly with others.",clientSecret:"Client secret",clientSecretDescription:"The client secret is known only to you and OSF. Do not display or expose it to others.",confirmDelete:{body:"Are you sure you want to delete this developer app? All users' access tokens will be revoked. This cannot be reversed.",title:"Delete app <strong>{appName}</strong>?"},createApp:"Create developer app",created:"Developer app created.",deleted:"Developer app deleted.",editApp:"Edit app",explanation:"The OSF allows third-party web applications to connect to the OSF on behalf of other users via the OAuth 2.0 web application flow.",hideSecret:"Hide client secret",resetSecret:{confirm:"Are you sure you want to reset the client secret? This cannot be reversed.",description:"Resetting the client secret will render your application unusable until it is updated with the new client secret, and all users must reauthorize access. Previously issued access tokens will no longer work.",error:"Error resetting client secret.",label:"Reset secret",modalTitle:"Reset client secret?",success:"Client secret successfully reset."},saved:"Developer app saved.",showSecret:"Show client secret",title:"Developer apps"},notifications:{title:"Notifications"},profile:{education:{title:"Education"},employment:{title:"Employment"},name:{apa:"APA",citationName:"Citation name",citationPreview:"Citation preview",familyName:"Family name (e.g. Franklin)",fullName:"Display name (e.g. Rosalind Elsie Franklin)",givenName:"Given name (e.g. Rosalind)",instructions:"Your full name, above, will be displayed in your profile. To control the way your name will appear in citations, edit the fields below.",middleNames:"Middle names (e.g. Elsie)",mla:"MLA",suffix:"Suffix",title:"Name"},social:{title:"Social"},title:"Profile information"},toggleNav:"Toggle navigation",tokens:{backToList:"Back to list of tokens",confirmDelete:{body:"Are you sure you want to delete this personal access token? This cannot be reversed.",title:"Delete token <strong>{tokenName}</strong>?"},createSuccess:{editScopes:"Edit scopes",instructions:"This token will never expire. This token should never be shared with others. If it is accidentally revealed publicly, it should be deactivated immediately.",message:"Token <strong>{tokenName}</strong> created:",warning:"This is the only time your token will be displayed."},createToken:"Create token",created:"Token created.",deleted:"Token deleted.",editToken:"Edit token",explanation:"Personal access tokens function like ordinary OAuth access tokens. They can be used to authenticate to the API.",saved:"Token saved.",scopes:"Scopes",scopesDescription:"Scopes limit access for personal access tokens.",title:"Personal access tokens",tokenName:"Token name"}},social:{email:"Email",facebook:"Facebook",github:"GitHub",google_group:"Google Group",twitter:"Twitter"},status:{alternate_email_error:"The email address has <b>NOT</b> been added to your account. Please log out and revisit the link in your email. Thank you.",component_deleted:"Component has been successfully deleted.",embargo_approved:"Your embargo approval has been accepted.",embargo_rejected:"Your disapproval has been accepted and the embargo has been cancelled.",embargo_termination_approved:"Your approval to make this embargo public has been accepted.",embargo_termination_rejected:"Your disapproval has been accepted and this embargo will not be made public.",project_deleted:"Project has been successfully deleted.",redirec
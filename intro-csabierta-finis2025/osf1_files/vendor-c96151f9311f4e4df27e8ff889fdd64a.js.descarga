ed)"},"expandable-preview":{show_less:"Show less",show_more:"Show more"},"file-browser":{add_button_aria:"Add files or folders here",breadcrumbs:"Breadcrumb",checked_out_file:"This file is checked out. Functionality is limited until it is checked in.",clear_selection:"Clear selection",confirm_delete:'Are you sure you want to delete "{fileName}"?',create_folder:{error_409:"A folder with that name already exists",error_ends_with_dot:"File name cannot end with period",error_forbidden_chars:"Please remove special characters from the folder name.",error_generic:"Something went wrong. Please try again.",error_message:"Please enter a folder name.",error_title:"Failed to create folder",new_folder_name:"New folder name",title:"Create folder"},delete:"Delete",delete_fail:'Failed to delete "{fileName}"',delete_file:"Delete file",delete_file_modal:{delete_failed:"{itemCount, plural, one {# item} other {# items}} failed to delete, click to try again",delete_success:"{itemCount, plural, one {# item} other {# items}} deleted successfully",deleting:"Deleting {itemCount, plural, one {# item} other {# items}}",heading:"Delete {itemCount, plural, one {# item} other {# items}}",retry:"retry delete"},delete_folder:"Delete folder",download_all:"Download this folder",download_count:"{count, plural, one {# Download} other {# Downloads}}",empty_folder:"This folder is empty.",errors:{load_file_list:"Failed to load files",load_file_provider:"Failed to load the file provider",load_file_provider_title:"Provider error",load_file_providers:"Failed to load list of addon providers"},exceeds_storage_limit:"- Insufficient storage at target location",file_rename_modal:{cancel:"Cancel",cancel_aria:"Cancel renaming file",clear_aria:"Clear input field",dialog_aria:"Files Rename modal",error_empty_name:"Please enter a file name.",error_ends_with_dot:"File name cannot end with a period.",error_forbidden_chars:"Please remove special characters from the file name.",error_message:"Please rename the file.",heading:"Rename file",input_aria:"User input field for renaming file",label:"Please enter a new name for the file:",name_input:"Please enter a new file name:",no_input:"Please enter a name.",rename:"Rename",retry_message:"Rename failed.",save:"Save",save_aria:"Save renaming file",success_message:"File successfully renamed."},filter_placeholder:"Filter current list",help_modal:{copy:"Copy",copy_detail_first:"You can copy your files from one part of your project or component to another. Select the files that you want to copy, and click the vertical ellipses",copy_detail_second:"to open the dropdown, click the “Copy” button. Choose a component, provider, or folder and then click “Copy”. Your files will now appear in both the original and chosen locations.",create_folder:"Create a folder",create_folder_detail:"To create a folder to help organize your files, click the green plus symbol, then click “Create a Folder”. Note: You can also organize your project content by creating Components.",download_all:"Download All Files As a Zip",download_all_detail:"Select the storage provider from the left navigation, and then click “Download this folder” in the top toolbar.",download_file:"Download a File",download_file_detail_first:"With the file open: Click the vertical ellipses",download_file_detail_second:"to open the dropdown. Click “Download”. From the file list: Click the vertical ellipses",download_file_detail_third:"of the file to open the dropdown. Click “Download”.",download_folder:"Download a Folder as Zip",download_folder_detail_first:"To download a specific folder as a zip, click the vertical ellipses",download_folder_detail_second:"on the folder’s row to open the dropdown. Click “Download”.<br>Alternatively, open the folder and then click “Download this folder” in the top toolbar.",file_actions_icon:"File actions icon",heading:"Using the OSF Files Browser",more_info_projects:'For more information please see our <a href="https://help.osf.io/article/387-project-files">help guides on project files</a>.',more_info_registrations:'For more information please see our <a href="https://help.osf.io/article/410-registration-files">help guides on registration files</a>.',move:"Move",move_detail_first:"You can move your files from one part of your project or component to another. Select the files that you want to move, and click the vertical ellipses",move_detail_second:"to open the dropdown, then click “move”. Choose a component, provider, or folder and then click “Move”.",providers:"See All Files in a Provider",providers_detail:"All connected storage providers are displayed in the left navbar. Choose one provider to view contents.",rename:"Rename a folder or file",rename_detail_first:"In the files list, select the file that you want to rename and click the vertical ellipses",rename_detail_second:"to open the dropdown. Select “Rename”. Note: Some special characters may cause unexpected behavior with certain addons.",select:"Select Files/Folders",select_detail:"Click on a row (outside of the file or folder name) to show further actions in the top toolbar. Click on more rows to select multiple files. To select a range of files, click a file to begin selection and then shift+click another file to select the range.",upload:"Upload",upload_detail_first:"There are two ways to upload files. Open the storage provider or folder where you intend to upload files; you can then drag files from your desktop into files list area OR click the green plus symbol",upload_detail_second:", then click “Upload Files”, and select your files. Note: File names with special characters may cause unexpected behavior with certain addons.",upload_icon:"File upload icon",view_files:"Open/View Files",view_files_detail:"Click a file name to go to view the file in the OSF. Opens file in a new tab."},number_selected:"{numberOfFilesSelected} item(s) selected","provider-specific-data":{dataverse:{latest:"(Draft)","latest-published":"(Published)"}},replace:"Replace",retry:"Retry",se
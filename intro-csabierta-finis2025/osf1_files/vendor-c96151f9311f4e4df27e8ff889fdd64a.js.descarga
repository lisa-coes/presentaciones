your project"},"schema-block-renderer/editable/files":{instructions:"You may attach up to 5 file(s) to this question. You may attach files that you already have in OSF Storage in this <a href={nodeUrl}>{projectOrComponent}</a> or upload (drag and drop) a new file from your computer. Uploaded files will automatically be added to this <a href={nodeUrl}>{projectOrComponent}</a> so that they can be registered. To attach files from other components or an add-on, first add them to this <a href={nodeUrl}>{projectOrComponent}</a>.",instructionsNoPermissions:'This registration is branched from <a href={nodeUrl}>an OSF Project</a>, and only contributors added to it can upload and edit files. Contact one of the registration\'s administrative contributors to be added to the project. Learn more about OSF Projects by visiting our <a href="https://help.osf.io/">help guides</a>.',instructionsNoProject:"You may attach up to 5 file(s) to this question. Files cannot total over 5GB in size.<br><br>Uploaded files will automatically be archived in this registration. They will also be added to a related project that will be created for this registration."},"schema-block-renderer/label":{editButtonAriaLabel:"Edit {questionLabel}",hideExample:"Hide example",showExample:"Show example",updated:"Updated"},"schema-block-renderer/read-only/files":{noFilesSelected:"No files selected"},"schema-block-renderer/read-only/response":{noResponse:"No response"}},"registries-side-nav":{collapseSideNav:"Collapse registration form navigation",expandSideNav:"Expand registration form navigation"},"registries-top-nav":{justification:"Return to justification",metadata:"Return to metadata",nextPage:"Next page",previousPage:"Previous page",reviewRegistration:"Review registration",showRegistrationNavigation:"Show registration form navigation"},"resources-list":{add_button_aria_label:"Add resource",add_instructions:"Link a DOI from a repository to your registration by clicking the green “+” button. Contributors affirmed to adhere to the criteria for each badge.",analytic_code:"Analytic Code",badge_alt:"{type} badge",data:"Data",delete_resource:{body:"Are you sure you want to delete this resource? This cannot be undone.",delete_failure:"Failed to delete resource.",delete_success:"Resource successfully deleted.",title:"Delete resource"},edit_resource:{add_failure:"Failed to add resource.",add_heading:"Add new resource",add_success:"Resource successfully added.",check_your_doi:"Check your DOI for accuracy.",description:"Description",doi:"DOI",doi_already_used:"A resource with this DOI and type already exists.",edit_button_aria_label:"Edit resource",edit_heading:"Edit resource",failed_to_validate:"Failed to validate DOI",output_type:"Resource type",preview:"Preview",save_success:"Resource successfully saved."},help_doc_link:"Learn more about linking resources to your registration",materials:"Materials","no-resources":"This registration has no resources.",papers:"Papers",supplements:"Supplements",undefined:"Choose one"},"search-bar":{aria:"Search",heading:"Discover public research",placeholder:"Search discipline, author...",search:"Search",subheading:"Discover projects, data, materials, and collaborators on OSF that might be helpful to your own research."},"sign-up-form":{confirm_email:"Confirm email",contact_email:"Contact email",full_name:"Full name",password:"Password",password_placeholder:"Password (Must be {min} to {max} characters)",registration_success:"Registration successful. Please check {email} to confirm your email address.",sign_up_button_label:"Sign up"},"sign-up-policy":{paragraph:'I have read and agree to the <a href="{link1}">Terms of Use</a> and <a href="{link2}">Privacy Policy</a>.'},subjects:{browse:{browse_all:"Browse all subjects",hide_child_subjects:"Hide child subjects",show_child_subjects:"Show child subjects"},display:{placeholder:"Your selections will appear here",remove_subject:"Remove subject"},search:{no_results:"No matching subjects found. Try a less specific search.",placeholder:"Type to search",search_all:"Search subjects"}},subscriptions:{error:"Error updating notification frequency.",frequency:{daily:"Daily",instant:"Instant",none:"None"},success:"Notification frequency updated."},"tags-widget":{add_tag:"Add a tag to enhance discoverability",no_tags:"No tags",remove_tag:"Remove tag",tags:"Tags"}},osf_mode_footer:{dev_mode:"This site is running in development mode."},page_not_found:{heading:"Page not found",message:"The page you were looking for is not found on the {brand} service."},paginator:{next:"Next page",page:"Page {page} of {max}",previous:"Previous page"},registration:{project_alert:'This registration is a frozen, non-editable version of <a class="link-solid" href="/{projectId}/">this project</a>'},registries:{application:{main_aria:"Registries main content",page_title:"OSF Registries"},branded:{page_title:"Registries"},discover:{SHARE:"About SHARE",error_loading:"There was an error loading registrations",go_to_SHARE:"Go to SHARE",no_results:"No results found.",order:{modified_ascending:"Modified Date (oldest to newest)",modified_descending:"Modified Date (newest to oldest)",relevance:"Relevance"},page_title:"Search",pagination:{next:"»",previous:"«"},registration_count:"{count, plural, =1 {# Registration} other {# Registrations}}",search_result:{last_edited:"Last edited: {date}",sharing_popover:"Share registration",toggle_result:"Toggle result",withdrawn:"Withdrawn"},sidebar:{provider_count:"{count, number, compact}",refine_search:"Refine Search",remove_filter_label:"Remove {filterName} filter"},sort_by:"Sort by",try_broadening:"Try broadening your search terms"},drafts:{draft:{delete_modal:{body:"Are you sure you want to delete this draft registration?",button:"Delete Draft",delete_error:"Unable to delete draft registration",title:"Delete this draft registration"},form:{back:"Back",collaborative_edit_warning:"Only one person is able to edit a registration draft at a time. Be sure to coordinate with any other contributors.",failed_auto_save:"Failed to auto-save draft registration form",last_saved:"Auto-saved: ",new_registration:"New registration",next:"Next",save_draft:"Save draft",save_failed:"Save failed. Unsaved changes present.",title:"Fill out registration form"},metadata:{failed_auto_save:"Failed to auto-save draft registration metadata",load_institutions_error:"Failed to load affiliated institutions",page_label:"Metadata",save_institutions_error:"Failed to save affiliated institutions",title:"Fill out basic registration info"},register:"Register",review:{invalid_warning:"Please address invalid or missing entries to complete registration.",non_admin_warning:"Only admins can submit a registration.",page_label:"Review",start_review:"Review",title:"Review registration before submitting",toggle_dropdown:"Toggle navigation dropdown"},submit_error:"Unable to create a registration.",unable_to_fetch_children_count:"Unable to fetch project's components"},index:{title:"Choose Unfinished Draft"},page_title:"View Registration Drafts"},edit_revision:{continue_edit_modal:{heading:"Are you sure this needs more edits?",reason:"What additional changes need to be made and why?",submit:"Submit",warning:"This will cancel any approvals from other admin contributors and return the registration back to its draft form for additional changes."},delete_modal:{body:"Are you sure you want to delete this draft update?",button:"Delete Draft Update",delete_error:"Unable to delete update",title:"Delete this draft update"},justification:{justification_description:"Justification will be provided to admins and moderators upon review. Once approved, it will be displayed at the top of the registration.",justification_label:"Explain the updates made to this registration and why the changes were necessary. Be thorough in your response.",page_label:"Justification",title:"Justification for Update"},page_title:"Update registration",review:{accept_changes:"Accept changes",action_submit_failed:"Your decision was not recorded",action_submit_success:"Your decision was recorded",continue_editing:"Continue editing",decision_recorded_notice:"Decision recorded. Pending decisions from other Admin contributors.",invalid_warning:"Please address invalid or missing entries to complete update.",justification_page_label:"Justification",no_justification:"No justification provided.",non_admin_warning:"Only admins can submit an update.",pending_admin_notice:"Pending decisions from admin(s).",pending_moderation_notice:"Pending decisions from moderators.",submit_changes:"Submit changes",submit_success:"Submitted for Admin approval"},revisionJustification:"Justification for update",updatedResponseKeys:"List of updated registration questions"},facets:{provider:{other_registries:"Other registries"},registration_type:{only_available_with_osf:"Only available with OSF Registries",registration_schema_error:"An error occurred getting registration types.",title:"OSF Registration Type"},subjects:{title:"Subjects"}},finalizeRegistrationModal:{back:"Back",datePlaceholder:"Choose embargo end date",embargoOption:"Enter registration into embargo",immediateOption:"Make registration public immediately",notice:{noModerationFromProject:'Remember:<ul><li>Registrations cannot be modified or deleted once submitted.</li><li>Changes to any files (1) in the projects or components being registered, (2) uploaded or selected as prompt responses, including those connected through add-ons during archiving will result in archiving failure and loss of your registration timestamp. Please do not modify your files until after you have received email confirmation of archiving completion. If this registration has been archiving for more than 72 hours, please email <a href="mailto:support@osf.io">support@osf.io</a> for assistance.</li><li>The content and version history of Wiki and OSF Storage will be copied to the registration.</li><li>This project may contain links to other projects. These links will be copied into your registration, but the projects that they link to will not be registered. If you wish to register the linked projects, they must be registered separately. <a href="{learnMoreLink}" target="_blank" rel="noopener noreferrer">Learn more about links</a>.</li><li>Registrations are archived on Internet Archive and a link to the archived copy will be added to the registration metadata.</li></ul>',noModerationNoProject:'Remember:<ul><li>Registrations cannot be modified or deleted once submitted.</li><li>Changes to any files uploaded or selected as prompt responses will result in archiving failure and loss of your registration timestamp. If this registration has been archiving for more than 72 hours, email <a href="mailto:support@osf.io">support@osf.io</a> for assistance.</li><li>Registrations are archived on Internet Archive and a link to the archived copy will be added to the registration metadata.</li></ul>',withModerationFromProject:'Remember:<ul><li>Registrations cannot be modified or deleted once submitted.</li><li>Changes to any files (1) in the projects or components being registered, (2) uploaded or selected as prompt responses, including those connected through add-ons during archiving will result in archiving failure and loss of your registration timestamp. Please do not modify your files until after you have received email confirmation of archiving completion. If this registration has been archiving for more than 72 hours, please email <a href="mailto:support@osf.io">support@osf.io</a> for assistance.</li><li>The content and version history of Wiki and OSF Storage will be copied to the registration.</li><li>This project may contain links to other projects. These links will be copied into your registration, but the projects that they link to will not be registered. If you wish to register the linked projects, they must be registered separately. <a href="{learnMoreLink}" target="_blank" rel="noopener noreferrer">Learn more about links</a>.</li><li>A moderator must review and approve your registration before it will be made public or embargoed.</li><li>Registrations are archived on Internet Archive and a link to the archived copy will be added to the registration metadata.</li></ul>',withModerationNoProject:'Remember:<ul><li>Registrations cannot be modified or deleted once submitted.</li><li>Changes to any files uploaded or selected as prompt responses will result in archiving failure and loss of your registration timestamp. If this registration has been archiving for more than 72 hours, email <a href="mailto:support@osf.io">support@osf.io</a> for assistance.</li><li>A moderator must review and approve your registration before it will be made public or embargoed.</li><li>Registrations are archived on Internet Archive and a link to the archived copy will be added to the registration metadata.</li></ul>'},submit:"Submit",title:"Almost done..."},form_view:{none_selected:"None selected"},forms:{form:{title:"Choose From Existing Registration Schema"},help:{title:"Help Choose Registration Form"},page_title:"Select Registration Forms"},header:{osf_registrations:"OSF Registrations",registrations:"Registrations",search_button:"Perform search",search_help:"Search help",search_label:"Search",search_placeholder:"Search registrations..."},index:{lead:'The <span class="f-w-lg">open</span> registries network',recent:{more:"See more",title:"Browse Registrations"},see_example:"See an example",services:{asist:"DARPA ASIST Registry",bottom:{contact:"Contact us"},characterlab:"Character Lab Registry",egap:"egap Registry",logo:"logo",metascience:"Metascience Registry",prereg:"Preregistration Challenge",rwe:"Real World Evidence Registry",top:{heading:"Registry Services",paragraph:"Leading registry service providers use this open source infrastructure to support their communities."},youth:"YOUth Study Registry"}},makeDecisionDropdown:{acceptRevision:"Accept update",acceptRevisionDescription:"Update will be accepted and registration will be updated",acceptSubmission:"Accept submission",acceptSubmissionDescription:"Registration will appear in search results and be made public. Embargoed registrations will only become public after embargo end date.",acceptWithdrawal:"Accept withdrawal",acceptWithdrawalDescription:"Registration will be withdrawn but still have a tombstone page with a justification for withdrawal and subset of the metadata available",additionalComment:"Additional comment",additionalCommentPlaceholder:"Add remarks to registration admins",failure:"Failed to submit moderator decision.",forceWithdraw:"Force withdraw",forceWithdrawDescription:"Registration will be withdrawn but still have a tombstone page with a justification for withdrawal and a subset of the metadata available",justificationForWithdrawal:"Justification for Withdrawal",justificationForWithdrawalPlaceholder:"Provide justification for withdrawal",makeDecision:"Make Decision",noModeratorActions:"No moderator decisions can be made at this time",rejectRevision:"Reject update",rejectRevisionDescription:"Update will be rejected and registration will remain unchanged",rejectSubmission:"Reject submission",rejectSubmissionDescription:"Registration will not appear in search results and will return to a private draft state",rejectWithdrawal:"Reject withdrawal",rejectWithdrawalDescription:"Registration will remain fully public",submit:"Submit",success:"Successfully submitted moderator decision."},moderation:{header:"Moderation",moderators:{addedNewModeratorError:"Error adding {permission}",addedNewModeratorSuccess:"Successfully added {userName} as {permission}",nameHeader:"Name",permissionHeader:"Permission",removedModeratorError:"Error removing {permission}",removedModeratorSuccess:"Successfully removed {userName}",title:"Moderators",updatedModeratorPermissionError:"Error updating permission to {permission}",updatedModeratorPermissionSuccess:"Successfully updated {userName} to {permission}"},overview:{confirm_delete:"Please confirm deletion of update.",delete_update:"Delete update",title:"Moderated Overview"},pending:{title:"Pending"},settings:{bulkUpload:"Bulk upload",bulkUploadHelpText:"Drag and drop the csv file that has the registration information to upload.",bulkUploadJobExists:{detail:"This csv file was already uploaded into the system and cannot be re-uploaded.",title:"Bulk upload job already exists"},bulkUploadNotAllowed:{detail:"Bulk upload is not enabled for this provider.",title:"Bulk upload not allowed"},cell:"Cell",copyToClipboard:"Copy to clipboard",copyToClipboardSuccess:"Successfully copied to clipboard.",dropCsvHere:"Drop csv file here to upload",duplicateColumnId:{detail:"The following column IDs appeared more than once. Please remove duplicate columns and re-upload. <br><strong>Duplicate column IDs</strong>: {duplicateIds}",title:"Duplicate column ID"},fileUploadNotSupported:{detail:"The schema ID specified in Cell A2 corresponds to a registration template with required file uploads. File uploads are not currently supported as part of the bulk upload workflow.",title:"File uploads not supported"},generalErrorMessage:'Your file was not uploaded due to the errors listed below. Please correct the errors and try again. If you have any questions, please contact the help desk at <a href="mailto:support@osf.io">support@osf.io</a>.',heading:"Configure reviews notification preferences",invalidCategoryName:{detail:'This category does not exist. Check that the category is spelled currently. See section “Field Formatting” in the <a href="https://drive.google.com/file/d/1FJT6Jl8kPJM95oWy5Dkueee-Sg81pz2m/view?usp=sharing">Moderator Guide</a> for a list of categories. Categories can be edited after the registration is submitted.',title:"Invalid category name"},invalidColumnId:{detail:'This Column ID does not match with the ones used by this registration template. It’s likely it was manually edited after it was downloaded or the registration template is outdated. Contact the help desk at <a href="mailto:support@osf.io">support@osf.io</a> for the current ID or a new csv file. <br><strong>Invalid IDs</strong>: {invalidIds}. <br><strong>Missing IDs</strong>: {missingIds}.',title:"Invalid column ID"},invalidContributors:{detail:'This contributors list does not match the system’s formatting requirements. Review the required formatting in the Moderator’s Manual. Contact the help desk at <a href="mailto:support@osf.io">support@osf.io</a> if this is not the issue.',title:"Invalid format for contributors"},invalidFileType:{detail:'Only csv files can be uploaded in the system. Convert the file into the csv format and reupload the document. Contact the Help Desk at <a href="mailto:support@osf.io">support@osf.io</a> if you have any questions.',title:"Invalid file type"},invalidInstitutionName:{detail:'This affiliated institution name does not match our system. Check that the institution’s name is spelled correctly. <a href="https://osf.io/institutions?view_only=">Click here</a> to view a list of currently active affiliated institutions.',title:"Invalid institution name"},invalidLicenseName:{detail:'This license does not match our system. It’s likely that the license is either spelled incorrectly, is not an option in our system, or formatted incorrectly. <a href="https://help.osf.io/hc/en-us/articles/360019739014-Licensing">Click here</a> to view a list of available licenses. See section “CSV Templates” in our Moderator’s Guide for more information on formatting specific licenses.',title:"Invalid license name"},invalidProjectId:{detail:"This Project GUID does not exist. Check that each project’s GUID is accurate. Registrations that do not have a project should have a blank cell.",title:"Invalid project ID"},invalidResponse:{detail:'This response is not acceptable by the system. It’s likely that this is due to misspelling or having multiple answers for a single response question. See section “Field Formatting” in the <a href="https://drive.google.com/file/d/1FJT6Jl8kPJM95oWy5Dkueee-Sg81pz2m/view?usp=sharing">Moderator Guide</a> for more information.',title:"Invalid response"},invalidSchemaId:{detail:'The schema ID in this cell does not match with a registration template in our system. It’s likely this ID was manually edited after it was downloaded or the registration template is outdated. Contact the help desk at <a href="mailto:support@osf.io">support@osf.io</a> for the current ID or a new csv file.',title:"Invalid schema ID"},invalidSubjectName:{detail:'This subject does not match our system. It’s likely it is spelled incorrectly. OSF uses the <a href="https://www.bepress.com/wp-content/uploads/2016/12/Disciplines_taxonomy_2018-01.pdf">bepress taxonomy</a>. Only the word or phase after the last colon needs to be entered.',title:"Invalid subject name"},missingAdminContributor:{detail:'This registration doesn’t include an admin contributor. A registration requires at least one admin contributor to be submitted. See section “Field Formatting” in the <a href="https://drive.google.com/file/d/1FJT6Jl8kPJM95oWy5Dkueee-Sg81pz2m/view?usp=sharing">Moderator Guide</a> for more information on formatting contributors.',title:"Missing admin contributor"},missingBibliographicContributor:{detail:'This registration doesn’t have any bibliographic contributors. Registration must have at least one bibliographic contributors. See section “Field Formatting” in the <a href="https://drive.google.com/file/d/1FJT6Jl8kPJM95oWy5Dkueee-Sg81pz2m/view?usp=sharing">Moderator Guide</a> for information on formatting contributors.',title:"Missing bibliographic contributor"},missingDescription:{detail:"This description is missing. Enter a high level summary of the registration. This summary can be edited after the registration is submitted.",title:"Missing description"},missingLicenseName:{detail:"This license is missing. Check that each registration has a license.",title:"Missing license name"},missingSubjectName:{detail:"This subject is missing. Check that each registration has a subject.",title:"Missing subject name"},missingTitle:{detail:"This title is missing. Check that each registration has a title.",title:"Missing title"},paragraph:"To configure other notification preferences visit your <a href={link}>user settings</a>.",sizeExceedsLimit:{detail:'The csv file exceeds the 1MB limit. Break the file into multiple files and reupload them. Contact the Help Desk at <a href="mailto:support@osf.io">support@osf.io</a> if you have any questions.',title:"File size exceeds limit"},title:"Settings",uploadError:"Upload error",uploadSuccess:"Successfully uploaded csv file."},states:{accepted:"Public",embargo:"Embargo",pending:"Pending",pendingWithdraw:"Pending Withdrawal",rejected:"Rejected",revisionPending:"Pending Updates",withdrawn:"Withdrawn"},submitted:{title:"Submitted"},withdrawals:{title:"Withdrawal Requests"}},myRegistrationsList:{createRegistration:"Create a registration",noDrafts:"You don't have any draft registrations. Create one with the button below.",noGeneral:"This page allows you to search and quickly access your registrations.",noRegistrations:"You don't have any submitted registrations. Create one with the button below."},my_registrations:{drafts:"Drafts",header:"My Registrations",sorted:"Sorted by last updated",submitted:"Submitted"},new:{component_help_text:"If your project includes components, you can select which components to include or exclude at the end of the registration.",go_to_dashboard:"your dashboard.",no:"No",page_header:"Add New Registration",page_title:"New Registration",provider_info:'You are submitting to {provider}. <a href="https://help.osf.io/">Click here</a> to learn more about other hosted registries.',required:"required",select_project:"Which project do you want to register?",select_project_placeholder:"Select your project",select_schema:"Which type of registration would you like to create?",start_registration:"Create draft",step_one:"Step 1",step_one_project_heading:"Do you have content for registration in an existing OSF project?",step_three:"Step 3",step_two:"Step 2",yes:"Yes"},newUpdateModal:{cancel_update:"Cancel update",learnMore:'Click <a href="https://help.osf.io/hc/en-us/articles/360035806634-Edit-Registration-Metadata" target="_blank">here</a>  to learn more.',modalBodyFirst:"Updates to registration responses can be updated by clicking “Next”.<br>Edits to metadata including Description, Category, License, Publication DOI, and Tags are done on the registration by clicking the ",modalBodyNoUpdates:"{registryName} does not allow updates.<br>Contact their registry if you have any questions.",modalBodySecond:" icon.",modalHeader:"Update your Registration",modalHeaderNoUpdates:"Updates not allowed",next:"Next"},overview:{accepted:{long_description:"This public registration is a frozen, non-editable version of this <strong><a href={projectUrl}>project</a></strong>.",short_description:"Public",text:"Public registration"},archiving:{currently_archiving:"This registration is currently archiving, and no changes can be made at this time.",email_support:'Changes to any files (1) in the projects or components being registered, (2) uploaded or selected as prompt responses, including those connected through add-ons during archiving will result in archiving failure and loss of your registration timestamp. Please do not modify your files until after you have received email confirmation of archiving completion. If this registration has been archiving for more than 72 hours, please email <a data-analytics-name="Email support" href="mailto:{supportEmail}">{supportEmail}</a> for assistance.',please_note:"Please note:"},bookmark:{add:{error:"Unable to bookmark this registration",success:"Registration successfully added to your bookmarks",text:"Bookmark"},remove:{error:"Unable to remove this registration from bookmarks",success:"Registration successfully removed from your bookmarks",text:"Remove from bookmarks"}},collapse:"Collapse",comments:{abuse_hate:"Hate speech",abuse_spam:"Spam or advertising",abuse_violence:"Violence or harmful behavior",cancel:"Cancel",cannot_retract_report:"Only the reporter can retract report",category_placeholder:"Select a category that best describes abuse",comment_abuse:"Comment reported.",comment_abuse_action:"Not abuse",create_report:{error:"Unable to report comment",success:"Comment successfully reported"},hide_replies:"Hide replies",load_more:"Load more replies",modified:"Modified ",no_comments:"No comments.",report:"Report",report_placeholder:"Describe abuse",retract_report:{error:"Unable to retract abuse report",success:"Report successfully retracted"},see_replies:"See replies",title:"Comments"},component_of:"This is a component of a registration:",components:{no_components:"This registration has no components.",title:"Components"},contents:"Contents",contributors:{gravatar_alt:"Gravatar for {name}",title:"Contributors"},embargo:{action:"End embargo early",action_error:"Unable to submit embargo termination request",action_success:"Embargo termination request successfully sent",confirm_button_text:"Confirm",confirm_text:"By clicking confirm, an email will be sent to project administrator(s) to approve ending the embargo. If approved, this registration, including any components, will be made public immmediately. This action is irreversible.",long_description:"This registration is embargoed. It will remain private until {embargoEndDate}.",short_description:"Embargoed",text:"Embargoed registration"},expand:"Expand",external_links:{analytics:"Analytics",wiki:"Wiki"},files:{outputFeaturePopoverBody:"You can now add DOIs for resources (ex. data, code, papers, etc.) to your registration.",outputFeaturePopoverHeading:"New feature!",storage_providers:{invalidProviderDetails:"Could not find the requested file provider.",invalidProviderLink:"See all files in this registration.",osfstorage:"OSF Storage"},title:"Files"},fork:{error:"Unable to fork registration",success:"Your fork is being created. You'll receive an email when it is complete",success_title:"Fork status"},fork_registration:"Fork this registration",form_view:{no_files:"No files selected"},inProgress:{long_description:"This registration is currently being updated by its contributors. Updates will be made available once approved.",short_description:"Updates being made",text:"Update in progress"},links:{linked_nodes:"Linked projects and components",linked_registrations:"Linked registrations",no_linked_nodes:"This registration has no linked projects or components.",no_linked_registrations:"This registration has no linked registrations.",title:"Links"},metadata:"Metadata",pending:{long_description:"This registration is awaiting a decision by the registry moderators. An email will notify all registration contributors of the decision.",short_description:"Pending moderator approval",text:"Pending moderation"},pendingEmbargoApproval:{long_description:"This registration is waiting for approval from its contributors. Once approved, the registration will remain private until the embargo ends.",short_description:"Pending embargo approval",text:"Pending approval"},pendingEmbargoTermination:{long_description:"This registration is waiting for approval from its contributors to terminate its embargo and be made public.",short_description:"Pending embargo termination",text:"Embargoed registration"},pendingModeration:{long_description:"This registration has an update that is waiting for moderation. Updates will be made available once approved.",short_description:"Update pending moderator approval",text:"Update pending review"},pendingRegistrationApproval:{long_description:"This registration is waiting for approval from its contributors.",short_description:"Pending registration approval",text:"Pending approval"},pendingWithdraw:{long_description:"This registration is waiting for approval to be withdrawn by registry moderators.",short_description:"Pending withdrawal moderation",text:"Pending withdrawal"},pendingWithdrawRequest:{long_description:"This registration is waiting for approval to be withdrawn by its contributors.",short_description:"Pending withdraw request",text:"Pending withdrawal"},resources:{analytic_code:{alt_text:"Analytic code badge",title:"Analytic code"},data:{alt_text:"Data badge",title:"Data"},error:"Unable to load Resource",help_icon:"Open resources",left_nav_title:"Open practice resources",materials:{alt_text:"Materials badge",title:"Materials"},papers:{alt_text:"Papers badge",title:"Papers"},supplements:{alt_text:"Supplements badge",title:"Supplements"},title:"Resources"},see_more:"See more",title:"Overview",toggle_navbar:"Toggle navigation",tooltips:{bookmark:"Bookmark this registration",fork:"Fork this registration",remove_bookmark:"Remove bookmark",share:"Share this registration"},unapproved:{long_description:"This registration has an update that is waiting for approval from its contributors. Updates will be made available once approved.",short_description:"Update pending approval",text:"Update pending"},versionMetadata:{date:"This update was made on {date}",description:"Updated responses are labeled",noReason:"No reason provided",originalDate:"This registration was submitted on {date}",originalTitle:"This is the original version of the registration",reason:"Reason for update:",updateTitle:"This is an update to the original registration"},view_forks:"View forks",withdraw:{error:"Unable to withdraw this registration",random_scientist_x:"Type <strong>{x}</strong> below and click Withdraw Registration if you are sure you want to continue.",success:"Withdrawal request submitted successfully",warning:'Withdrawing a registration will remove its content from the OSF, but leave basic metadata behind. The title of a withdrawn registration and its contributor list will remain, as will justification or explanation of the withdrawal, should you wish to provide it. Withdrawn registrations will be marked with a "withdrawn" tag. This action is irreversible.',withdraw:"Withdraw registration",withdrawal_justification:"Withdrawal justification",withdrawal_justification_label:"Please provide your justification for withdrawing this registration."},withdrawn:{date_withdrawn:"Date withdrawn",has_been_withdrawn:"This registration has been withdrawn for the reason(s) stated below.",justification:"Justification for withdrawal",no_justification:"None given",state:"Withdrawn"}},overviewHeader:{needModeratorPermission:"You do not have permission to moderate this registration."},partialRegistrationModal:{cancelButton:"Cancel",clearAll:"Clear All",componentContributorWarning:"Contributor changes for included components must be done on the component contributor page before submitting this registration.",continueButton:"Continue",selectAll:"Select All",title:"Select Components"},registrationList:{accepted:"No public registrations have been found",embargo:"No embargoed registrations have been found",pending:"No registrations pending approval have been found",pending_moderation:"No registrations found with updates pending",pending_withdraw:"No registrations found pending withdrawal",rejected:"No rejected registrations have been found",withdrawn:"No withdrawn registrations have been found"},registration_metadata:{add_contributors:{add_contributor_aria:"Add contributor",add_new_button:"Add new contributors",add_unregistered_contributor:"Add unregistered contributor",clear_all:"Clear all",done_add_new_button:"Done adding new contributors",error_loading:"Error, could not load contributors",help_text:"<p>Search results will appear here. Click the + icon in each row to set permissions for that contributor.</p><p>You can perform additional searches to add more contributors. Your selections will remain listed below until you click Save.</p>",no_results:"No results found",results_heading:"Results",save:"Save",search:"Search",search_placeholder:"Search by name or profile information",section_heading:"Add Contributors"},add_description:"Add description",add_license:"Add license",affiliated_institutions:"Affiliated institutions",associated_project:"Associated project",category:"Category",choose_license:"Choose a License",citation:"Citation",contributors:"Contributors",create_doi:"Create DOI",date_created:"Date created",date_registered:"Date registered",description:"Description",disciplines:"Disciplines",edit_category:{error:"Unable to save category.",success:"Category successfully updated."},edit_description:{error:"Unable to save description.",success:"Description successfully updated."},edit_field:"Edit {field}",edit_institutions:{error:"Unable to save affiliated institutions.",success:"Affiliated institutions successfully updated."},edit_license:{error:"Unable to save license.",success:"License successfully updated."},edit_provider_metadata:{error:"Unable to save registry metadata.",success:"Registry metadata updated."},edit_pub_doi:{error:"Unable to save publication DOI.",success:"Publication DOI successfully updated."},edit_tags:{error:"Unable to save tags.",success:"Tags successfully updated."},embargo_end_date:"Date embargo ends",internet_archive_link:"Internet Archive link",license:"License",license_help_text:'A license tells others how they can use your work in the future and only applies to the information and files submitted with the registration. For more information, see this <a href="https://help.osf.io/hc/en-us/articles/360019739014-Licensing">article on licenses</a>.',load_subjects_error:"Unable to load subjects",metadata_page_description:"This metadata applies only to the registration you are creating, and will not be applied to your project.",metadata_page_heading:"Registration Metadata",mint_doi:{error:"Unable to create registration DOI.",header:"Are you sure you want to create a DOI for this registration?",success:"DOI successfully created.",text:"A DOI is persistent and will always resolve to this page."},no_affiliated_institutions:"No affiliated institutions",no_copyrightHolders:"No copyright holders